{
  "version": 1,
  "description": "二叉树/二叉搜索树黄金集：问题 → 期望资料 + 答案关键词。用于检索门禁（Recall@5 / Hit@1 / KeywordHit@1）。",
  "cases": [
    {
      "id": "bt-01",
      "question": "二叉树第 i 层最多有多少个结点？",
      "expected_source": "01_二叉树的定义与性质.txt",
      "keyword": "2^(i-1)"
    },
    {
      "id": "bt-02",
      "question": "深度为 k 的二叉树最多有多少个结点？",
      "expected_source": "01_二叉树的定义与性质.txt",
      "keyword": "2^k - 1"
    },
    {
