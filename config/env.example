# ==================== LLM配置 ====================
# LLM提供商 (deepseek, ollama)
LLM_PROVIDER=deepseek

# DeepSeek配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2000

# Ollama配置
OLLAMA_MODEL=llama2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2000

# ==================== RAG配置 ====================
# 检索文档数量
RAG_TOP_K=5

# 文本分割配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# 本地模型目录（可选，设置后优先使用本地模型，无需联网下载）
# EMBEDDING_LOCAL_DIR=models/bge-small-zh-v1.5/snapshots/<snapshot-hash>

# HuggingFace镜像（国内网络需要设置，否则模型下载会超时）
# HF_ENDPOINT=https://hf-mirror.com

# 知识库隔离模式 (directory, collection)
# directory: 每个学科独立目录 data/vector_store/{subject_id}/
# collection: 单个数据库多个collection（不推荐）
RAG_ISOLATION_MODE=directory

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径 (留空则输出到控制台)
LOG_FILE=

# 日志轮转配置
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 是否启用控制台输出
LOG_CONSOLE_OUTPUT=true

# ==================== 服务配置 ====================
# 服务主机
SERVICE_HOST=0.0.0.0

# 服务端口
SERVICE_PORT=8000

# 调试模式
DEBUG=false

# CORS配置 (JSON数组格式)
CORS_ORIGINS=["*"]

# 最大请求大小 (字节)
MAX_REQUEST_SIZE=10485760

# 工作进程数
SERVICE_WORKERS=1
