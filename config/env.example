# ========================
# 环境变量配置示例
# 此文件仅用于参考，项目内置了默认API密钥，无需创建.env即可运行
# 如需覆盖默认配置，复制此文件为 .env 并修改
# 优先级：.env 环境变量 > config/models.py 内置默认值
# ========================

# ----- 模型配置 -----
# 默认**文本**模型：deepseek / mimo / qwen（默认：deepseek）
# 2026-09-25：MiMo 会员到期，默认文本模型统一为 DeepSeek；MiMo 仅作可选提供方，不会自动回退。
# LLM_MODEL=deepseek

# 知识图谱独立模型（可选）：默认复用聊天默认模型
# 建议独立配置，避免图谱构建与聊天相互影响
# GRAPH_MODEL=deepseek-chat

# 小米MiMo配置
# MIMO_API_KEY=<your-mimo-api-key>
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek配置
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问配置（需要自行申请API Key）
# DASHSCOPE_API_KEY=<your-dashscope-api-key>
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== RAG配置 ====================
# 检索文档数量
RAG_TOP_K=5

# 文本分割配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# Embedding加载模式 (auto, offline, online)
# auto（默认）: 显式本地目录 > 本地缓存 > 在线（本地有模型时不访问网络）
# offline: 仅本地目录/本地缓存，不访问网络，本地缺失立即降级为BM25
# online: 允许在线加载（仍优先复用本地缓存）
# EMBEDDING_LOAD_MODE=auto

# 本地模型目录（可选，设置后优先使用本地模型，无需联网下载）
# EMBEDDING_LOCAL_DIR=models/bge-small-zh-v1.5/snapshots/<snapshot-hash>

# HuggingFace镜像（国内网络需要设置，否则模型下载会超时）
# HF_ENDPOINT=https://hf-mirror.com

# 知识库隔离模式 (directory, collection)
# directory: 每个学科独立目录 data/vector_store/{subject_id}/
# collection: 单个数据库多个collection（不推荐）
RAG_ISOLATION_MODE=directory

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径 (留空则输出到控制台)
LOG_FILE=

# 日志轮转配置
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 是否启用控制台输出
LOG_CONSOLE_OUTPUT=true

# ==================== 服务配置 ====================
# 服务主机
SERVICE_HOST=0.0.0.0

# 服务端口
SERVICE_PORT=8000

# 调试模式
DEBUG=false

# CORS配置 (JSON数组格式)
CORS_ORIGINS=["*"]

# 最大请求大小 (字节)
MAX_REQUEST_SIZE=10485760

# 工作进程数
SERVICE_WORKERS=1
