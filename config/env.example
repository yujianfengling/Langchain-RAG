# ========================
# 环境变量配置示例
# 此文件仅用于参考。**必须**创建 .env 并填写模型 API Key，否则文字问答无法使用
# （项目自 2026-10 起不再内置任何密钥，keys 只来自 .env 或 config/local_secrets.json）
# 如需覆盖默认配置，复制此文件为 .env 并修改
# 优先级：.env 环境变量 > config/local_secrets.json（两者均已 gitignore，不会入库）
# ========================

# ----- 模型配置 -----
# 默认**文本**模型：deepseek / mimo / qwen（默认：deepseek）
# 2026-09-25：MiMo 会员到期，默认文本模型统一为 DeepSeek；MiMo 仅作可选提供方，不会自动回退。
# LLM_MODEL=deepseek

# 知识图谱独立模型（可选）：默认复用聊天默认模型
# 建议独立配置，避免图谱构建与聊天相互影响
# GRAPH_MODEL=deepseek-chat

# 小米MiMo配置
# MIMO_API_KEY=<your-mimo-api-key>
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek配置
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问配置（需要自行申请API Key）
# DASHSCOPE_API_KEY=<your-dashscope-api-key>
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== RAG配置 ====================
# 检索文档数量
RAG_TOP_K=5

# 文本分割配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# Embedding供应商（2026-10-28 起默认 local）
# local（默认）: 本地 BGE，离线可用，不需要任何云端 key
# cloud（可选）: 阿里云百炼 text-embedding-v4（需 DASHSCOPE_API_KEY，1024 维）
#   两套向量不可混用：索引 meta 会记 embedding_provider，查询时按 meta 选同一套编码器。
# EMBEDDING_PROVIDER=local
# EMBEDDING_CLOUD_MODEL=text-embedding-v4
# EMBEDDING_CLOUD_DIMENSIONS=1024

# Embedding加载模式 (auto, offline, online)
# auto（默认）: 显式本地目录 > 本地缓存 > 在线（本地有模型时不访问网络）
# offline: 仅本地目录/本地缓存，不访问网络，本地缺失立即降级为BM25
# online: 允许在线加载（仍优先复用本地缓存）
# EMBEDDING_LOAD_MODE=auto

# 本地模型目录（可选，设置后优先使用本地模型，无需联网下载）
# EMBEDDING_LOCAL_DIR=models/bge-small-zh-v1.5/snapshots/<snapshot-hash>

# HuggingFace镜像（国内网络需要设置，否则模型下载会超时）
# HF_ENDPOINT=https://hf-mirror.com

# 知识库隔离模式 (directory, collection)
# directory: 每个学科独立目录 data/vector_store/{subject_id}/
# collection: 单个数据库多个collection（不推荐）
RAG_ISOLATION_MODE=directory

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径 (留空则输出到控制台)
LOG_FILE=

# 日志轮转配置
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 是否启用控制台输出
LOG_CONSOLE_OUTPUT=true

# ==================== 服务配置 ====================
# 服务主机
SERVICE_HOST=0.0.0.0

# 服务端口
SERVICE_PORT=8000

# 调试模式
DEBUG=false

# CORS配置 (JSON数组格式)
CORS_ORIGINS=["*"]

# 最大请求大小 (字节)
MAX_REQUEST_SIZE=10485760

# 工作进程数
SERVICE_WORKERS=1

# ==================== 语音（本地语音服务，可选；仅语音输入/ASR） ====================
# 轻量栈（sherpa-onnx，默认按需下载到仓库之外；无需 PyTorch）
# 首次真正使用"录音提问"时才下载 ASR 模型；启动、打开网页、健康检查都不会下载。
SPEECH_MODEL_CACHE_DIR=D:/speech_models          # 模型缓存目录（**请用纯英文路径**）
SPEECH_ASR_ENGINE=funasr                         # funasr | sensevoice（轻量）
SPEECH_ASR_MODEL_KEY=                            # 轻量 ASR 模型键（留空用推荐值）
SPEECH_ASR_LANGUAGE=auto                         # auto | zh | en | ja | ko | yue
SPEECH_ASR_USE_ITN=1                             # 1=输出标点并做数字/单位归一化
SPEECH_NUM_THREADS=0                             # ONNX 线程数（0=自动）
SPEECH_MODEL_OFFLINE=0                           # 1=禁止联网下载（离线机房）
# 手动指定已有 ASR 模型目录（命中则完全不下载）
SPEECH_ASR_MODEL_DIR=
SPEECH_QUEUE_WAIT_SECONDS=20
# 说明：回答朗读（TTS/CosyVoice/Kokoro/Piper/音色/SPEECH_TTS_*）已整体移除。

# ==================== 视觉识图（可选） ====================
# 注意：这是本项目最大的坑之一 —— VISION_MODE=ocr 会**完全跳过**识图，
# 扫描版课件/PPT 截图里的正文将永远进不了知识库。
VISION_MODE=vision                 # vision | ocr
VISION_MIN_IMAGE_BYTES=8192        # 小于该字节数的图片直接跳过（默认 8KB）
# 视觉提供方顺序：deepseek > mimo > qwen（带凭证探活）；下面按需二选一
DEEPSEEK_VISION_MODEL=             # 留空则复用 DEEPSEEK_MODEL
DASHSCOPE_VISION_MODEL=            # 例：qwen-vl-plus

# ==================== 联网补题（可选） ====================
# 知识库证据不足时用 Tavily 找素材，再由本地模型重新推导答案；不配则静默降到"通用知识"层
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_PREGEN_POINTS=8
WEB_SEARCH_PREGEN_COUNT=3

# ==================== 部署 ====================
# 数据根目录：设置后所有库/索引/日志都落在这里（不设置则用 <项目根>/data）
EDU_DATA_DIR=
# 分角色部署：student / teacher（只影响入口跳转；后端权限始终严格校验）
APP_ROLE=
# 教师身份白名单（逗号分隔的用户名）；也可用管理员签发 T- 邀请码
TEACHER_USERS=
ADMIN_USERS=
# 不设置时"课程资料管理"退化为"任一登录用户"（会打启动告警）
KNOWLEDGE_ADMIN_USERS=

# ==================== 主后端 → 本地语音服务（可选，语音输入用） ====================
SPEECH_BACKEND=auto                # auto | local | mimo
LOCAL_SPEECH_URL=http://127.0.0.1:8100
LOCAL_SPEECH_TIMEOUT=120           # 单次转写超时（秒）
LOCAL_SPEECH_HEALTH_TIMEOUT=15

# ==================== 当前**无效**的配置项（如实标注，避免误导） ====================
# 以下变量在 .env 里写了也不生效（代码里没有消费者，或读取后未使用）。
# 详见交付报告"配置指南"一节；接线或删除由负责人决定。
#   RAG_TOP_K            已修复（2026-10-03，参见 chat_service._default_top_k）
#   LOG_LEVEL / LOG_FILE / LOG_MAX_BYTES / LOG_BACKUP_COUNT / LOG_CONSOLE_OUTPUT
#   SERVICE_HOST / SERVICE_PORT / SERVICE_WORKERS / MAX_REQUEST_SIZE / DEBUG
#   RAG_ISOLATION_MODE（collection 模式未实现）
#   RAG_RETRIEVAL_POOL
#   LLM_PROVIDER（默认模型只认 LLM_MODEL）
#   SPEECH_ASR_LANGUAGE / SPEECH_ASR_USE_ITN  已修复（2026-10-03）
